# ============================================================================
# Insaf Mart — environment variables
# Copy this file to `.env.local` (local dev) or paste the values into your
# Vercel / Netlify project settings. Never commit real keys.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: same URL exposed to the browser. Not required by the app — every
# database read/write goes through server-side route handlers.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# --- Admin panel login (/admin) ---------------------------------------------
# The admin account is created/reconciled from these values on first login.
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password_here

# --- Email: OTP, invoices, admin order alerts -------------------------------
# Gmail App Password (16 characters, no spaces) — NOT your Gmail password.
# Google Account → Security → 2-Step Verification → App passwords.
# Leave both blank to run in preview mode: emails are logged to the server
# console and listed in the admin panel's Email tab instead of being sent,
# and the sign-in screen shows the OTP on screen.
EMAIL_USER=your_gmail@example.com
EMAIL_APP_PASSWORD=your_16_digit_app_password_here

# --- Optional: non-Gmail SMTP -----------------------------------------------
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_SECURE=true
